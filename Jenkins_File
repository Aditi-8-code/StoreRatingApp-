
pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'jenkins',
                    url: 'https://github.com/sayalimali16/StoreRatingApp-.git'
                echo 'GitHub checkout completed'
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run install:all'
                    } else {
                        bat 'npm run install:all'
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run build'
                    } else {
                        bat 'npm run build'
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm run test --if-present'
                    } else {
                        bat 'npm run test --if-present'
                    }
                }
                echo 'Test stage completed'
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'
        }
        failure {
            echo 'BUILD FAILED - Check Console Output'
        }
    }
}
